<?xml version="1.0" encoding="utf-8"?>
<!-- 설연 한눈에 (날씨·시계 + 비서)
     4×2: [날씨 아이콘·기온 / 동네·날씨]          [시계 / 날짜]
          ───────────────────────────
          설연  지금 가장 중요한 한 가지
          [일정] [가계부 N]                          (마이크)
     4×1: 날짜·날씨 한 줄 + 설연 한 줄 + 마이크
     배경: 낮 블루 / 밤 네이비 그라데이션 (GlanceWidget이 바꿈) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/wg_bg_night"
    android:paddingStart="18dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="12dp">

    <!-- 날씨 · 시계 (4×2 이상) -->
    <LinearLayout android:id="@+id/w_wx" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <ImageView android:id="@+id/w_wx_ic" android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_wx_moon" android:contentDescription="날씨" />
                <TextView android:id="@+id/w_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                    android:textColor="#FFFFFFFF" android:textSize="32sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
            </LinearLayout>
            <TextView android:id="@+id/w_place" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:textColor="#CCFFFFFF" android:textSize="12.5sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="end">
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:format12Hour="h:mm" android:format24Hour="HH:mm"
                android:textColor="#FFFFFFFF" android:textSize="36sp" android:fontFamily="sans-serif-medium" android:includeFontPadding="false" />
            <TextClock android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:format12Hour="M월 d일 EEEE" android:format24Hour="M월 d일 EEEE"
                android:textColor="#CCFFFFFF" android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/w_gap" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <FrameLayout android:id="@+id/w_div" android:layout_width="match_parent" android:layout_height="1dp" android:background="@drawable/wg_line" />

    <!-- 설연 한 줄 (+ 4×1이면 오른쪽 마이크) -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_top" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="2dp"
                android:textColor="#CCFFFFFF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:visibility="gone" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="설연" android:textColor="#FF9CC0F0" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/w_main" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp"
                    android:textColor="#FFFFFFFF" android:textSize="14.5sp" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <LinearLayout android:id="@+id/w_more" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
                <TextView android:id="@+id/w_l1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
                    android:textColor="#D9FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
                <TextView android:id="@+id/w_l2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="#D9FFFFFF" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <ImageView android:id="@+id/w_mic_s" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginStart="8dp"
            android:background="@drawable/wg_mic_bg" android:src="@drawable/ic_wg_mic" android:padding="10dp"
            android:contentDescription="말로 하기" android:visibility="gone" />
    </LinearLayout>

    <!-- 바로가기 (4×2 이상) -->
    <LinearLayout android:id="@+id/w_bar" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:layout_marginTop="10dp">
        <LinearLayout android:id="@+id/w_go_sch" android:layout_width="wrap_content" android:layout_height="34dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/wg_chip" android:paddingStart="11dp" android:paddingEnd="13dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_wg_cal" android:contentDescription="일정" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="일정" android:textColor="#FFFFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout android:id="@+id/w_go_led" android:layout_width="wrap_content" android:layout_height="34dp" android:layout_marginStart="8dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/wg_chip" android:paddingStart="11dp" android:paddingEnd="13dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_wg_wallet" android:contentDescription="가계부" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="가계부" android:textColor="#FFFFFFFF" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
            <TextView android:id="@+id/w_badge" android:layout_width="wrap_content" android:layout_height="18dp" android:layout_marginStart="6dp"
                android:minWidth="18dp" android:gravity="center" android:paddingStart="5dp" android:paddingEnd="5dp"
                android:background="@drawable/widget_badge_bg" android:textColor="#FFFFFFFF" android:textSize="11sp" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>
        <FrameLayout android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <ImageView android:id="@+id/w_mic" android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/wg_mic_bg" android:src="@drawable/ic_wg_mic" android:padding="10dp"
            android:contentDescription="말로 하기" />
    </LinearLayout>
</LinearLayout>
